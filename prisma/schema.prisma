generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StationType {
  PC
  CONSOLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SevaStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  COMPLETED
}

enum EnquiryStatus {
  NEW
  FOLLOW_UP
  ENROLLED
  CLOSED
}

model Station {
  id         String        @id @default(cuid())
  name       String        @unique
  type       StationType
  specs      String
  hourlyRate Int
  isActive   Boolean       @default(true)
  bookings   Booking[]
  createdAt  DateTime      @default(now())
}

model Booking {
  id            String        @id @default(cuid())
  station       Station       @relation(fields: [stationId], references: [id])
  stationId     String
  customerName  String
  customerPhone String
  startAt       DateTime
  endAt         DateTime
  durationHours Int
  totalAmount   Int
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([stationId, startAt])
}

model SevaRequest {
  id            String     @id @default(cuid())
  applicantName String
  phone         String
  serviceType   String
  notes         String?
  status        SevaStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model CourseEnquiry {
  id          String        @id @default(cuid())
  studentName String
  phone       String
  courseName  String
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
