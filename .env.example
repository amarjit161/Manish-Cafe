# Supabase Postgres connection (Project Settings > Database > Connection pooling > Transaction mode, port 6543).
# Use the pooler host (aws-0-<region>.pooler.supabase.com), not db.<ref>.supabase.co directly —
# the direct host is IPv6-only and unreachable from many networks/dev boxes.
# Transaction mode (6543, pgbouncer=true) multiplexes connections and avoids exhausting the
# free-tier pool (session mode on 5432 caps out at 15 total connections).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Admin login
ADMIN_EMAIL="admin@manishcafe.in"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# IMPORTANT: escape every "$" as "\$" in this file, otherwise Next.js's .env
# loader will try to expand it as a variable and corrupt the hash.
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-your-own-bcrypt-hash"
AUTH_SECRET="replace-with-a-long-random-string"
