# Supabase Postgres connection (Project Settings > Database > Connection pooling > Transaction mode, port 6543).
# Use the pooler host (aws-0-<region>.pooler.supabase.com), not db.<ref>.supabase.co directly —
# the direct host is IPv6-only and unreachable from many networks/dev boxes.
# Transaction mode (6543, pgbouncer=true) multiplexes connections and avoids exhausting the
# free-tier pool (session mode on 5432 caps out at 15 total connections).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Admin login
ADMIN_EMAIL="admin@manishcafe.in"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# IMPORTANT: escape every "$" as "\$" in this file, otherwise Next.js's .env
# loader will try to expand it as a variable and corrupt the hash.
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-your-own-bcrypt-hash"
AUTH_SECRET="replace-with-a-long-random-string"

# Supabase (SaaS portal: customer/retailer/admin auth + RLS-protected data)
# Project Settings > API. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service-role key -- SERVER-ONLY. Never prefix NEXT_PUBLIC_, never import
# from a "use client" file, never commit a real value. Bypasses RLS entirely.
# Project Settings > API > service_role secret. Used only by
# scripts/create-staff-account.ts to provision retailer/admin accounts.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key-from-supabase-dashboard"

# Cloudflare R2 documents -- Next.js never talks to R2 directly (no S3-style
# access/secret keys here). It only calls the manishcafe-documents Worker
# over HTTP, which holds the actual R2 (DOCUMENTS) binding. SERVER-ONLY:
# never prefix NEXT_PUBLIC_, never import from a "use client" file.
R2_WORKER_URL="https://manishcafe-documents.<your-subdomain>.workers.dev"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value on the Worker with: wrangler secret put R2_WORKER_SHARED_SECRET
R2_WORKER_SHARED_SECRET="replace-with-a-long-random-shared-secret"
